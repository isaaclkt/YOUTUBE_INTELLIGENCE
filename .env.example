# Copie este arquivo para .env antes de rodar o projeto.

# Banco local (fase 1). Para Postgres: postgresql://user:pass@host:5432/db
DATABASE_URL="file:./dev.db"

# Ponto único de troca mock/real. Valores: "mock" | "real".
# "real" = interpretação por IA via Anthropic, com fallback automático
# para o mock quando não há chave ou a chamada falha.
SERVICES_MODE="real"

# As chaves NÃO vão aqui: coloque em .env.local (nunca commitado):
#   ANTHROPIC_API_KEY=...   (interpretação por IA)
#   YOUTUBE_API_KEY=...     (coleta real via YouTube Data API v3)
