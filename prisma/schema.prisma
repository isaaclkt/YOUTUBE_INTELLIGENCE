// ============================================================
// Fase 1: SQLite local (arquivo prisma/dev.db).
//
// MIGRAÇÃO FUTURA PARA POSTGRES:
//   1. Trocar `provider = "sqlite"` por `provider = "postgresql"`.
//   2. Apontar DATABASE_URL (.env) para o banco Postgres.
//   3. Opcional: trocar o campo `resultJson String` por `resultJson Json`.
//   4. Rodar `npx prisma migrate dev`.
// Nenhum outro código da aplicação precisa mudar — a persistência
// passa toda por src/lib/repository.ts.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Cache de respostas de APIs externas (YouTube Data API), TTL 24h.
// Poupa quota: análises repetidas do mesmo tema não gastam unidades.
model ApiCache {
  key       String   @id // sha256 do endpoint+parâmetros (sem a chave da API)
  payload   String // JSON da resposta
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

// Categorias/sementes do Radar, gerenciáveis pela tela ⚙️ Categorias.
// As varreduras usam apenas as ativas; sementes por idioma em JSON.
model RadarCategory {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  rpmTier   String // "high" | "medium" | "low"
  active    Boolean  @default(true)
  seedsJson String // Record<LanguageCode, string> — termos separados por "|"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Uma análise executada pelo motor. Os campos denormalizados
// (verdict, opportunityScore) existem para listar o histórico
// sem precisar desserializar `resultJson`.
model Analysis {
  id               String   @id @default(cuid())
  query            String
  language         String
  country          String
  verdict          String // "YES" | "MAYBE" | "NO" | "INSUFFICIENT_DATA"
  // Null quando o veredito é INSUFFICIENT_DATA: sem evidência não há score.
  opportunityScore Int?
  resultJson       String // AnalysisResult serializado (JSON)
  createdAt        DateTime @default(now())

  @@index([createdAt])
}

// Leituras sucessivas da contagem de views de um vídeo.
// Reler videos.list de ids já conhecidos custa 1 unidade por 50 vídeos,
// e é a única forma de obter velocidade REAL — views por dia entre duas
// leituras, sem o viés de idade que contamina views÷tempo-desde-publicação.
//
// REGRA: alimenta apenas o indicador longitudinal exibido ao lado do
// resultado. NUNCA entra no Opportunity Score nem no veredito.
model VideoReading {
  id        String   @id @default(cuid())
  videoId   String
  views     Int
  readAt    DateTime @default(now())

  @@index([videoId, readAt])
}
